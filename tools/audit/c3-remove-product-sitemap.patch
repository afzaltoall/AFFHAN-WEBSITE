@@ -7,14 +7,24 @@ export default function robots(): MetadataRoute.Robots {
       allow: '/',
       disallow: ['/admin', '/admin/login', '/employee', '/api/'],
     },
-    // Two sitemaps, both listed. robots.txt allows any number of Sitemap
-    // lines and Google reads them all, which is simpler than maintaining a
-    // sitemap index by hand: /sitemap.xml stays the static-page map, and the
-    // product map is generated and sharded by generateSitemaps in
-    // src/app/products/sitemap.ts.
-    sitemap: [
-      'https://affhan.com/sitemap.xml',
-      'https://affhan.com/products/sitemap.xml',
-    ],
+    // One sitemap, deliberately.
+    //
+    // The product map was withdrawn: 11,785 of the 11,807 URLs the site
+    // submitted were catalogue pages, 99.8% of the whole. By this repo's own
+    // measurement a product page is 69% boilerplate, leaving ~87 words that
+    // are about the product, and for a CJ listing those 87 are the name and
+    // the category path. Submitting eleven thousand of those alongside
+    // twenty-two written pages asks Google to judge the site on the
+    // catalogue.
+    //
+    // THE PAGES STAY LIVE AND INDEXABLE. /products/<id>/ still renders, still
+    // carries no noindex, and is still reachable from the catalogue and from
+    // internal links, so anything Google already has it keeps and anything it
+    // finds by crawling it may still index. Withdrawing a sitemap is a
+    // statement about what we are asking it to prioritise, not a removal.
+    //
+    // src/app/products/sitemap.ts is left in place and unreferenced so this
+    // is one line to undo.
+    sitemap: 'https://affhan.com/sitemap.xml',
   };
 }
